# ============================================
# LLM Configuration
# ============================================

# High tier (Planning/Reasoning/Review)
LLM_HIGH_PROVIDER=anthropic
LLM_HIGH_MODEL=claude-opus-4-6
LLM_HIGH_TEMPERATURE=0.1
LLM_HIGH_MAX_TOKENS=4096

# Medium tier (Writing)
LLM_MEDIUM_PROVIDER=anthropic
LLM_MEDIUM_MODEL=claude-sonnet-4-6
LLM_MEDIUM_TEMPERATURE=0.3
LLM_MEDIUM_MAX_TOKENS=4096

# Light tier (Retrieval optimization)
LLM_LIGHT_PROVIDER=ollama
LLM_LIGHT_MODEL=qwen3.5:32b
LLM_LIGHT_TEMPERATURE=0.5
LLM_LIGHT_MAX_TOKENS=2048

# ============================================
# API Keys
# ============================================

ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Custom OpenAI-format API endpoint
# OPENAI_API_BASE=https://api.openai.com/v1

# ============================================
# Storage Configuration
# ============================================

CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=documents

# ============================================
# Performance Configuration
# ============================================

# Document ingestion
BATCH_SIZE=20
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval
TOP_K=10
MAX_RETRIEVAL_ITERATIONS=5

# Concurrency
MAX_WORKERS=4

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ============================================
# Cache Configuration
# ============================================

ENABLE_CACHE=true
CACHE_TTL=3600
SEMANTIC_CACHE_THRESHOLD=0.95

# ============================================
# Monitoring Configuration
# ============================================

ENABLE_METRICS=true
METRICS_PORT=9090
