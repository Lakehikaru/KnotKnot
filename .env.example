# ============================================
# LLM Configuration
# ============================================

# High tier (Planning/Reasoning/Review)
LLM_HIGH_PROVIDER=openai
LLM_HIGH_MODEL=gpt-4
LLM_HIGH_TEMPERATURE=0.1
LLM_HIGH_MAX_TOKENS=4096

# Medium tier (Writing)
LLM_MEDIUM_PROVIDER=openai
LLM_MEDIUM_MODEL=gpt-4
LLM_MEDIUM_TEMPERATURE=0.3
LLM_MEDIUM_MAX_TOKENS=4096

# Light tier (Retrieval optimization)
LLM_LIGHT_PROVIDER=openai
LLM_LIGHT_MODEL=gpt-3.5-turbo
LLM_LIGHT_TEMPERATURE=0.5
LLM_LIGHT_MAX_TOKENS=2048

# ============================================
# API Keys
# ============================================

OPENAI_API_KEY=your-openai-api-key-here

# Optional: Custom OpenAI-format API endpoint
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: Anthropic API (if using anthropic provider)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# Storage Configuration
# ============================================

CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=documents

# ============================================
# Performance Configuration
# ============================================

# Document ingestion
BATCH_SIZE=20
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval
TOP_K=10
MAX_RETRIEVAL_ITERATIONS=5

# Concurrency
MAX_WORKERS=4

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ============================================
# Cache Configuration
# ============================================

ENABLE_CACHE=true
CACHE_TTL=3600
SEMANTIC_CACHE_THRESHOLD=0.95

# ============================================
# Monitoring Configuration
# ============================================

ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# Streamlit Configuration
# ============================================

# Server settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=false
STREAMLIT_SERVER_RUN_ON_SAVE=true

# Client settings
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=true
STREAMLIT_CLIENT_TOOLBAR_MODE=viewer

# Logger settings
STREAMLIT_LOGGER_LEVEL=info

# Theme
STREAMLIT_THEME_PRIMARY_COLOR=#FF6B6B
STREAMLIT_THEME_BACKGROUND_COLOR=#FFFFFF
STREAMLIT_THEME_SECONDARY_BACKGROUND_COLOR=#F0F2F6
STREAMLIT_THEME_TEXT_COLOR=#262730
STREAMLIT_THEME_FONT=sans serif
